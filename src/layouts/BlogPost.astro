---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { slugifyTag } from '../lib/slug';
import Layout from './Layout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	article?: boolean;
	prevPost?: CollectionEntry<'blog'>;
	nextPost?: CollectionEntry<'blog'>;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags,
	prevPost,
	nextPost,
	article = true,
} = Astro.props;

const otherEditions = [prevPost, nextPost].filter(
	(post): post is CollectionEntry<'blog'> => post !== undefined,
);
---

<Layout title={title} description={description} image={heroImage} article={article}>
	<main class="page-main post-main">
		<article class="reveal">
			<div class="hero-image">
				{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
			</div>
			<div class="prose">
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Última actualización: <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					{
						tags && tags.length > 0 && (
							<ul class="tags">
								{tags.map((tag) => (
									<li>
										<a href={`/blog/tag/${slugifyTag(tag)}/`}>{tag}</a>
									</li>
								))}
							</ul>
						)
					}
					<hr class="rule" />
				</div>
				<slot />
			</div>
			{
				otherEditions.length > 0 && (
					<div class="other-editions">
						<p class="other-editions-label">En otras ediciones...</p>
						<ul class="other-editions-list">
							{otherEditions.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image
												width={480}
												height={320}
												src={post.data.heroImage}
												alt={post.data.title}
											/>
										)}
										<p class="card-title">{post.data.title}</p>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</article>
	</main>

	<style>
		.post-main {
			width: calc(100% - 2em);
			max-width: 100%;
			margin: 0;
		}
		.hero-image {
			width: 100%;
		}
		.hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 4px;
		}
		.prose {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: auto;
			padding: 1em;
			color: var(--ink);
		}
		.title {
			margin-bottom: 1em;
			padding: 1em 0;
			text-align: center;
			line-height: 1;
		}
		.title h1 {
			margin: 0 0 0.5em;
		}
		.date {
			font-family: var(--font-heading);
			font-size: 0.85rem;
			margin-bottom: 0.5em;
			color: var(--ink-muted);
		}
		.last-updated-on {
			font-style: italic;
		}
		.tags {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem;
			list-style: none;
			margin: 0 0 1em;
			padding: 0;
		}
		.tags li a {
			display: block;
			font-family: var(--font-heading);
			font-size: 0.78rem;
			color: var(--ink-muted);
			text-decoration: none;
			border: 1px solid var(--rule);
			border-radius: 999px;
			padding: 0.2rem 0.7rem;
			transition: color 0.15s ease, border-color 0.15s ease;
		}
		.tags li a:hover {
			color: var(--accent);
			border-color: var(--accent);
		}
		.other-editions {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: 3em auto 0;
			padding-top: 1.5em;
			border-top: 1px solid var(--rule);
		}
		.other-editions-label {
			font-family: var(--font-heading);
			font-size: 0.72rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--ink-muted);
			font-weight: 500;
			margin: 0 0 1.6rem;
		}
		.other-editions-list {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem 1.25rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.other-editions-list li a {
			display: block;
			text-decoration: none;
		}
		.other-editions-list img {
			display: block;
			width: 100%;
			aspect-ratio: 3 / 2;
			object-fit: cover;
			border-radius: 4px;
			margin-bottom: 0.6rem;
		}
		.card-title {
			margin: 0;
			font-family: var(--font-heading);
			font-weight: 700;
			font-size: 1rem;
			letter-spacing: -0.01em;
			line-height: 1.3;
			color: var(--ink);
			transition: color 0.15s ease;
		}
		.other-editions-list li a:hover .card-title {
			color: var(--accent);
		}
		.other-editions-list li a:hover img {
			opacity: 0.85;
		}
		@media (max-width: 480px) {
			.other-editions-list {
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}
		}
	</style>
</Layout>

---
import type { ImageMetadata } from 'astro';
import '../styles/landing.css';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Topbar from '../components/Topbar.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	article?: boolean;
	footerVariant?: 'full' | 'simple';
}

const { title, description, image, article = false, footerVariant = 'simple' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead />
		<SEO title={title} description={description} image={image} article={article} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Ginés López García" />
		<meta property="og:locale" content="es_ES" />
		<meta name="theme-color" content="#FDFDFC" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
		<slot name="head" />
	</head>
	<body>
		<Topbar />
		<slot />
		<SiteFooter variant={footerVariant} />

		<button type="button" class="to-top" id="toTop" aria-label="Volver arriba">↑</button>

		<script is:inline>
			var yearEl = document.getElementById('year');
			if (yearEl) yearEl.textContent = new Date().getFullYear();

			if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				var els = document.querySelectorAll('.reveal');
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				}, { threshold: 0 });
				els.forEach(function (el) { io.observe(el); });
			} else {
				document.querySelectorAll('.reveal').forEach(function (el) {
					el.classList.add('is-visible');
				});
			}

			var toTop = document.getElementById('toTop');
			var showToTopAt = window.innerHeight * 0.6;
			window.addEventListener('scroll', function () {
				toTop.classList.toggle('is-visible', window.scrollY > showToTopAt);
			}, { passive: true });
			toTop.addEventListener('click', function () {
				window.scrollTo({
					top: 0,
					behavior: window.matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto'
				});
			});
		</script>
	</body>
</html>

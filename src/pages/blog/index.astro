---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = `Blog — ${SITE_TITLE}`;
const description =
	'Artículos sobre desarrollo web, oposiciones docentes e inteligencia artificial aplicada a la programación.';
---

<Layout title={title} description={description}>
	<main class="page-main blog-list">
		<section class="reveal">
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<style>
		.blog-list {
			width: 960px;
			max-width: calc(100% - 2em);
			margin: 0 auto;
		}
		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 2rem;
			list-style-type: none;
			margin: 0;
			padding: 0;
		}
		ul li {
			width: calc(50% - 1rem);
		}
		ul li * {
			text-decoration: none;
			transition: opacity 0.15s ease, color 0.15s ease;
		}
		ul li:first-child {
			width: 100%;
			margin-bottom: 1rem;
			text-align: center;
		}
		ul li:first-child img {
			width: 100%;
		}
		ul li:first-child .title {
			font-size: 2.369rem;
		}
		ul li img {
			display: block;
			margin-bottom: 0.75rem;
			border-radius: 4px;
		}
		ul li a {
			display: block;
		}
		.title {
			margin: 0;
			font-family: var(--font-sans);
			font-weight: 800;
			letter-spacing: -0.01em;
			color: var(--ink);
			line-height: 1.2;
		}
		.date {
			max-width: none;
			margin: 0.3rem 0 0;
			font-family: var(--font-mono);
			font-size: 0.8rem;
			color: var(--ink-muted);
		}
		ul li a:hover h4,
		ul li a:hover .date {
			color: var(--accent);
		}
		ul a:hover img {
			opacity: 0.85;
		}
		@media (max-width: 720px) {
			ul {
				gap: 0.5em;
			}
			ul li {
				width: 100%;
				text-align: center;
			}
			ul li:first-child {
				margin-bottom: 0;
			}
			ul li:first-child .title {
				font-size: 1.563em;
			}
		}
	</style>
</Layout>

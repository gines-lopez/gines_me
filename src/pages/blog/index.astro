---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = `Blog de IA aplicada a la educación — ${SITE_TITLE}`;
const description =
	'Diario de lo que aprendo aplicando IA en la docencia y en mis propios proyectos: qué funciona, qué no, y por qué.';
---

<Layout title={title} description={description}>
	<main class="page-main blog-list">
		<section class="reveal">
			<div class="wrap">
				<h1 class="section-title">IA aplicada a la educación</h1>
				<p>
					Todo lo que voy aprendiendo sobre IA aplicada a la educación: en
					el aula, en mis clases de DAM, DAW y SMR, y en los dos proyectos
					que estoy construyendo.
				</p>
			</div>
			<PostList posts={posts} />
		</section>
	</main>

	<style>
		.blog-list {
			width: 960px;
			max-width: 100%;
			margin: 0 auto;
		}
	</style>
</Layout>

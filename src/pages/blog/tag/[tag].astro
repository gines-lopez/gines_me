---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PostList from '../../../components/PostList.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE } from '../../../consts';
import { slugifyTag } from '../../../lib/slug';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const tagMap = new Map<string, { label: string; posts: CollectionEntry<'blog'>[] }>();

	for (const post of posts) {
		for (const tag of post.data.tags) {
			const slug = slugifyTag(tag);
			const entry = tagMap.get(slug) ?? { label: tag, posts: [] };
			entry.posts.push(post);
			tagMap.set(slug, entry);
		}
	}

	return Array.from(tagMap.entries()).map(([slug, { label, posts: tagPosts }]) => ({
		params: { tag: slug },
		props: {
			label,
			posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	label: string;
	posts: CollectionEntry<'blog'>[];
}

const { label, posts } = Astro.props;

const title = `${label} — Blog — ${SITE_TITLE}`;
const description = `Artículos etiquetados con «${label}» en el blog de ${SITE_TITLE}.`;
---

<Layout title={title} description={description} noindex>
	<main class="page-main">
		<header class="blog-header">
			<p class="blog-header__eyebrow">Etiqueta</p>
			<h1 class="blog-header__title">{label}</h1>
		</header>
		<section class="blog-section reveal">
			<div class="blog-container">
				<PostList posts={posts} headingLevel={2} />
			</div>
		</section>
	</main>

	<style>
		.blog-header {
			padding: 56px 16px 24px;
			text-align: center;
		}
		.blog-header__eyebrow {
			margin: 0 0 12px;
			font-family: var(--font-heading);
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--accent);
		}
		.blog-header__title {
			margin: 0 auto;
			font-size: clamp(2.25rem, 7vw, 4rem);
			line-height: 1.05;
		}
		.blog-section {
			border-top: none;
			padding: 40px 0 80px;
		}
		.blog-container {
			max-width: 1248px;
			margin: 0 auto;
			padding: 0 16px;
		}
		@media (min-width: 576px) {
			.blog-header {
				padding: 104px 16px 40px;
			}
		}
	</style>
</Layout>

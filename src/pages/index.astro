---
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/LatestPosts.astro';

const title = 'Ginés López — IA aplicada a la educación y al desarrollo';
const description =
	'Ginés López: profesor de FP en Informática que aplica IA generativa en el aula y en sus proyectos, y comparte en el blog lo que de verdad funciona.';
---

<Layout title={title} description={description} footerVariant="full">
	<script slot="head" type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ginés López",
  "url": "https://gines.me/",
  "email": "mailto:docentegineslopez@gmail.com",
  "jobTitle": "Profesor de Formación Profesional en Informática",
  "description": "Formador especializado en IA aplicada a la educación, profesor funcionario de Formación Profesional en Informática (DAM) y desarrollador web con más de 10 años de experiencia.",
  "worksFor": {
    "@type": "GovernmentOrganization",
    "name": "Generalitat Valenciana - Consellería de Educación"
  },
  "sameAs": [
    "https://www.linkedin.com/in/gineslopez/",
    "https://www.instagram.com/docentegineslopez",
    "https://github.com/gines-lopez"
  ],
  "knowsLanguage": ["es", "en", "fr", "ca"],
  "knowsAbout": [
    "Inteligencia Artificial aplicada a la educación",
    "Inteligencia Artificial aplicada al desarrollo",
    "Formación Profesional",
    "Oposiciones docentes",
    "Desarrollo de Aplicaciones Multiplataforma",
    "Desarrollo de Aplicaciones Web",
    "Sistemas Microinformáticos y Redes",
    "PrestaShop",
    "WordPress",
    "Kotlin",
    "JavaScript",
    "PHP"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "ES"
  }
}
	</script>

	<div class="hero-screen">
		<div class="hero">
			<div class="wrap">
				<p class="eyebrow">IA aplicada a la educación · Formación Profesional · Oposiciones</p>
				<h1>IA aplicada a la educación, desde el aula de FP.</h1>
				<p class="subhead">
					Uso IA generativa cada día para programar, corregir código y
					preparar clases, y llevo lo que aprendo a las aulas de DAM, DAW y
					SMR.
				</p>
				<p class="hero-note">Funcionario de Carrera en la Generalitat Valenciana desde 2025.</p>
				<div class="hero-actions">
					<a class="btn primary" href="/contacto/">Escribir un correo</a>
					<a class="btn" href="https://gines-lopez.github.io" target="_blank" rel="noopener">Mis apuntes</a>
					<a class="btn" href="https://docentemente.com" target="_blank" rel="noopener">Docentemente</a>
				</div>
			</div>
		</div>
	</div>

	<hr class="rule" />

	<main>
		<section id="historia" class="reveal">
			<div class="wrap">
				<h2 class="section-title">¿Quién es Ginés López?</h2>
				<p>
					Soy Ginés López, formador especializado en <strong>IA aplicada a
					la educación</strong> y <strong>profesor de Formación Profesional
					en Informática</strong>. Llevo la inteligencia artificial
					generativa a las aulas de DAM, DAW y SMR: la uso a diario para
					preparar clases, corregir código y diseñar evaluaciones, y
					comparto con alumnos y docentes lo que de verdad funciona, sin
					humo.
				</p>
				<p>
					Antes de dar clase fui <strong>más de cinco años desarrollador
					web</strong>, especializado en PrestaShop y WordPress. Ese oficio de
					escribir código para clientes reales es el que traslado hoy al
					aula y a cualquier proyecto en el que colaboro.
				</p>
				<p>
					Hoy soy <strong>funcionario de carrera</strong> de la Generalitat
					Valenciana tras aprobar la <strong>oposición de Informática</strong>.
					Ese mismo oficio y esa misma constancia son los que aplico en cada
					proyecto: quiero que mis alumnos —y quien trabaje conmigo— salgan
					sabiendo trabajar con IA, no compitiendo contra ella.
				</p>
			</div>
		</section>

		<section id="ultimo" class="reveal">
			<div class="wrap">
				<h2 class="section-title">Lo último que he hecho</h2>
				<p>
					Un diario de lo que aprendo llevando la IA al aula y construyendo
					dos proyectos propios: lo que funciona, lo que no, y por qué.
				</p>
				<LatestPosts />
				<p class="see-all"><a href="/blog/">Ver todos los artículos →</a></p>
			</div>
		</section>
	</main>
</Layout>

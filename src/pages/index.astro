---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PROJECTS } from '../consts';
import { getCover } from '../lib/cover';
import foto from '../assets/gines-lopez.png';

const title = 'Ginés López — Solopreneur educativo. El diario de un proyecto en público';
const description =
	'Ginés López, profesor de FP en Informática, construye CódigoFP y docentemente en solitario y cuenta cada mes en El diario lo que funciona, lo que no y lo que haría distinto.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];
const cover = latest ? getCover(latest) : undefined;
const issue = latest ? (latest.data.edition ?? posts.length) : undefined;
---

<Layout title={title} description={description}>
	<script slot="head" type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ginés López",
  "url": "https://gines.me/",
  "jobTitle": "Profesor de Formación Profesional en Informática y solopreneur educativo",
  "description": "Profesor de FP en Informática y solopreneur educativo. Construye docentemente y CódigoFP en solitario y cuenta el proceso cada mes en El diario.",
  "worksFor": {
    "@type": "GovernmentOrganization",
    "name": "Generalitat Valenciana - Consellería de Educación"
  },
  "sameAs": [
    "https://www.linkedin.com/in/gineslopez/",
    "https://www.instagram.com/docentegineslopez",
    "https://github.com/gines-lopez"
  ],
  "knowsLanguage": ["es", "en", "fr", "ca"],
  "knowsAbout": [
    "Emprendimiento educativo",
    "Building in public",
    "Newsletters y productos digitales educativos",
    "Formación Profesional",
    "Desarrollo web"
  ],
  "address": { "@type": "PostalAddress", "addressCountry": "ES" }
}
	</script>

	<main class="home">
		<header class="masthead">
			<div class="masthead__text">
				<h1 class="masthead__title">Emprendo en solitario <span>y lo cuento todo.</span></h1>
				<p class="masthead__lede">
					Soy Ginés López, profesor de FP en Informática. Construyo
					{' '}<strong>CódigoFP</strong> y <strong>docentemente</strong> con lo que me deja la
					jornada lectiva, y cada mes lo anoto en El diario: lo que funciona, lo que no y lo
					que haría distinto.
				</p>
				<div class="masthead__actions">
					<a class="btn primary" href="/proyectos/">Ver lo que construyo</a>
					<a class="btn" href={latest ? `/blog/${latest.id}/` : '/blog/'}>
						{latest ? 'Leer la última edición' : 'Entrar al diario'}
					</a>
				</div>
			</div>
			<figure class="masthead__plate">
				<div class="plate__sheet" aria-hidden="true"></div>
				<Image
					src={foto}
					alt="Ginés López señalando a cámara"
					widths={[360, 520, 720, 1000]}
					sizes="(min-width: 900px) 470px, 80vw"
					format="webp"
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>Fig. 1 · El autor, en obras</figcaption>
			</figure>
		</header>

		<section id="proyectos" class="block">
			<div class="block__inner">
				<h2 class="block__title">Lo que estoy construyendo</h2>
				<ul class="ledger">
					<li>
						<a class="ledger__row" href={PROJECTS.codigofp} target="_blank" rel="noopener">
							<span class="ledger__name">CódigoFP</span>
							<span class="ledger__desc">
								Newsletter y producto para opositores a FP que tienen que hacer su
								programación didáctica.
							</span>
							<span class="ledger__go">codigofp.com ↗</span>
						</a>
					</li>
					<li>
						<a class="ledger__row" href={PROJECTS.docentemente} target="_blank" rel="noopener">
							<span class="ledger__name">docentemente</span>
							<span class="ledger__desc">
								Una carta gratuita cada domingo para docentes, con recursos, opiniones y
								criterio.
							</span>
							<span class="ledger__go">docentemente.com ↗</span>
						</a>
					</li>
				</ul>
				<p class="block__more"><a href="/proyectos/">Cómo nacieron y en qué punto están →</a></p>
			</div>
		</section>

		<section id="diario" class="block block--tint">
			<div class="block__inner">
				<h2 class="block__title">El diario</h2>
				<p class="block__lede">
					Una edición al mes. Sin postureo: lo construido, lo que salió bien, lo que no y qué
					haría distinto.
				</p>
				{
					latest ? (
						<a class="edition" href={`/blog/${latest.id}/`}>
							<div class="edition__cover">
								{cover && (
									<Image
										src={cover}
										alt=""
										widths={[480, 720, 1040]}
										sizes="(min-width: 900px) 560px, 100vw"
										loading="lazy"
									/>
								)}
							</div>
							<div class="edition__body">
								<p class="edition__meta">
									Edición n.º {issue} · <FormattedDate date={latest.data.pubDate} format="long" />
								</p>
								<h3 class="edition__title">{latest.data.title}</h3>
								<p class="edition__desc">{latest.data.description}</p>
								<span class="edition__go">Leer la edición →</span>
							</div>
						</a>
					) : (
						<div class="edition edition--empty">
							<div class="edition__cover edition__cover--blank" aria-hidden="true">
								<span>Plano n.º 1</span>
							</div>
							<div class="edition__body">
								<p class="edition__meta">Edición n.º 1 · noviembre de 2026</p>
								<h3 class="edition__title">La primera edición está en el tablero.</h3>
								<p class="edition__desc">
									Saldrá aquí y en el <a href="/rss.xml">RSS</a>. Mientras tanto, la carta de cada
									domingo está en <a href={PROJECTS.docentemente} target="_blank" rel="noopener">docentemente</a>.
								</p>
							</div>
						</div>
					)
				}
				<p class="block__more"><a href="/blog/">Ver todas las ediciones →</a></p>
			</div>
		</section>

		<section id="autor" class="block">
			<div class="block__inner block__inner--split">
				<h2 class="block__title">Quién escribe esto</h2>
				<div class="prose">
					<p>
						Más de cinco años programando tiendas online en una agencia de eCommerce, y desde
						2022 dando clase: hoy soy <strong>profesor de FP en Informática</strong>, funcionario
						de carrera en la Generalitat Valenciana.
					</p>
					<p>
						En paralelo monto mis propios proyectos y uso la IA como copiloto para llegar con el
						poco tiempo que queda. Todo lo que pasa por el camino acaba en El diario.
					</p>
					<p class="block__more"><a href="/sobre-mi/">Leer la historia completa →</a></p>
				</div>
			</div>
		</section>
	</main>

	<style>
		.home {
			padding-top: var(--topbar-h);
		}

		/* ---------- Hero ---------- */
		.masthead {
			text-align: left;
			display: grid;
			gap: 2rem;
			max-width: 1160px;
			margin: 0 auto;
			padding: 2.5rem 1.5rem 0;
		}
		.masthead__title {
			max-width: 12ch;
			margin: 0 0 1.4rem;
			font-size: clamp(2.8rem, 9vw, 5.2rem);
			line-height: 1.02;
			letter-spacing: -0.03em;
			font-weight: 500;
			text-wrap: balance;
		}
		.masthead__title span {
			font-style: italic;
			color: var(--accent);
		}
		.masthead__lede {
			max-width: 36ch;
			margin: 0 0 2rem;
			font-size: 1.25rem;
			line-height: 1.5;
			color: var(--ink-muted);
		}
		.masthead__lede strong {
			color: var(--ink);
			font-weight: 600;
		}
		.masthead__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.9rem;
		}
		.masthead__plate {
			position: relative;
			align-self: end;
			margin: 0;
			display: flex;
			justify-content: center;
		}
		.plate__sheet {
			position: absolute;
			inset: 8% 0 2.2rem;
			border: 1px solid var(--accent);
			background-color: var(--accent-soft);
			background-image:
				linear-gradient(color-mix(in srgb, var(--accent) 22%, transparent) 1px, transparent 1px),
				linear-gradient(90deg, color-mix(in srgb, var(--accent) 22%, transparent) 1px, transparent 1px);
			background-size: 32px 32px;
		}
		.masthead__plate img {
			position: relative;
			display: block;
			width: min(380px, 78vw);
			height: auto;
			margin-bottom: 2.2rem;
		}
		.masthead__plate figcaption {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			font-family: var(--font-ui);
			font-size: 0.72rem;
			letter-spacing: 0.06em;
			color: var(--ink-muted);
			text-align: right;
			padding: 0.6rem 0.2rem 0;
			border-top: 1px solid var(--accent);
		}
		@media (min-width: 900px) {
			.masthead {
				grid-template-columns: 1.15fr 0.85fr;
				gap: 4rem;
				padding-top: 4rem;
				min-height: calc(100dvh - var(--topbar-h));
			}
			.masthead__text {
				align-self: center;
				padding-bottom: 4rem;
			}
			.masthead__plate img {
				width: 100%;
				max-width: 460px;
			}
		}

		/* ---------- Bloques ---------- */
		.block {
			border-top: 1px solid var(--ink);
			padding: 4rem 0;
		}
		.block--tint {
			background: var(--paper-2);
		}
		.block__inner {
			max-width: 1160px;
			margin: 0 auto;
			padding: 0 1.5rem;
		}
		.block__title {
			margin: 0 0 1.4rem;
			font-size: clamp(1.9rem, 4.5vw, 3rem);
			line-height: 1.08;
			letter-spacing: -0.02em;
			font-weight: 500;
		}
		.block__lede {
			max-width: 44ch;
			margin: 0 0 2.4rem;
			color: var(--ink-muted);
		}
		.block__more {
			margin: 2rem 0 0;
			font-family: var(--font-ui);
			font-weight: 600;
			font-size: 0.94rem;
		}
		.block__more a {
			text-decoration: none;
			position: relative;
		}
		.block__more a:hover {
			text-decoration: underline;
		}
		@media (min-width: 900px) {
			.block__inner--split {
				display: grid;
				grid-template-columns: 0.85fr 1.15fr;
				gap: 4rem;
			}
		}
		.prose p {
			margin: 0 0 1rem;
			max-width: 52ch;
		}

		/* ---------- Proyectos ---------- */
		.ledger {
			list-style: none;
			margin: 2.4rem 0 0;
			padding: 0;
			border-bottom: 1px solid var(--rule);
		}
		.ledger__row {
			display: grid;
			gap: 0.5rem 2rem;
			padding: 1.8rem 0;
			border-top: 1px solid var(--rule);
			color: var(--ink);
			text-decoration: none;
			transition: background-color 0.2s ease;
		}
		.ledger__name {
			font-family: var(--font-heading);
			font-size: clamp(2rem, 5vw, 3.2rem);
			font-weight: 500;
			letter-spacing: -0.02em;
			line-height: 1.05;
		}
		.ledger__desc {
			max-width: 40ch;
			color: var(--ink-muted);
		}
		.ledger__go {
			font-family: var(--font-ui);
			font-weight: 600;
			font-size: 0.9rem;
			color: var(--accent);
		}
		.ledger__row:hover .ledger__name {
			color: var(--accent);
		}
		@media (min-width: 900px) {
			.ledger__row {
				grid-template-columns: 1fr 1fr 11rem;
				align-items: baseline;
			}
		}

		/* ---------- Edición ---------- */
		.edition {
			display: grid;
			gap: 1.6rem;
			color: var(--ink);
			text-decoration: none;
		}
		@media (min-width: 900px) {
			.edition {
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3rem;
				align-items: center;
			}
		}
		.edition__cover {
			border: 1px solid var(--ink);
			aspect-ratio: 16 / 9;
			overflow: hidden;
			background: var(--accent-soft);
		}
		.edition__cover img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.edition__cover--blank {
			display: grid;
			place-items: end start;
			padding: 1rem;
			background-image:
				linear-gradient(color-mix(in srgb, var(--accent) 25%, transparent) 1px, transparent 1px),
				linear-gradient(90deg, color-mix(in srgb, var(--accent) 25%, transparent) 1px, transparent 1px);
			background-size: 32px 32px;
			font-family: var(--font-ui);
			font-size: 0.75rem;
			letter-spacing: 0.06em;
			color: var(--accent);
		}
		.edition__meta {
			margin: 0 0 0.6rem;
			font-family: var(--font-ui);
			font-size: 0.82rem;
			color: var(--ink-muted);
		}
		.edition__title {
			margin: 0 0 0.8rem;
			font-family: var(--font-heading);
			font-size: clamp(1.6rem, 3.4vw, 2.3rem);
			font-weight: 500;
			line-height: 1.12;
			letter-spacing: -0.015em;
			text-wrap: balance;
		}
		.edition__desc {
			margin: 0 0 1.2rem;
			max-width: 44ch;
			color: var(--ink-muted);
		}
		.edition__go {
			font-family: var(--font-ui);
			font-weight: 600;
			font-size: 0.94rem;
			color: var(--accent);
		}
		a.edition:hover .edition__title {
			color: var(--accent);
		}
		@media (max-width: 480px) {
			.masthead {
				padding-top: 1.8rem;
			}
			.masthead__actions .btn {
				width: 100%;
				text-align: center;
			}
			.block {
				padding: 3rem 0;
			}
		}
	</style>
</Layout>

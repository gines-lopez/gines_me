---
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/LatestPosts.astro';

const title = 'Ginés López García — Profesor de FP, experto en oposiciones e IA';
const description =
	'Ginés López García: profesor funcionario de Formación Profesional en Informática (DAM) para la Generalitat Valenciana, opositor aprobado y desarrollador web con más de 10 años de experiencia que enseña IA aplicada al desarrollo.';
---

<Layout title={title} description={description} footerVariant="full">
	<script slot="head" type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ginés López García",
  "url": "https://gines.me/",
  "email": "mailto:docentegineslopez@gmail.com",
  "jobTitle": "Profesor de Formación Profesional en Informática",
  "description": "Profesor funcionario de Formación Profesional en Informática (DAM), opositor aprobado y desarrollador web con más de 10 años de experiencia, experto en IA aplicada al desarrollo.",
  "worksFor": {
    "@type": "GovernmentOrganization",
    "name": "Generalitat Valenciana - Consellería de Educación"
  },
  "sameAs": [
    "https://www.linkedin.com/in/gineslopez/",
    "https://www.instagram.com/docentegineslopez",
    "https://github.com/gines-lopez"
  ],
  "knowsLanguage": ["es", "en", "fr", "ca"],
  "knowsAbout": [
    "Formación Profesional",
    "Oposiciones docentes",
    "Inteligencia Artificial aplicada al desarrollo",
    "Desarrollo de Aplicaciones Multiplataforma",
    "Desarrollo de Aplicaciones Web",
    "Sistemas Microinformáticos y Redes",
    "PrestaShop",
    "WordPress",
    "Kotlin",
    "JavaScript",
    "PHP"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "ES"
  }
}
	</script>

	<div class="hero-screen">
		<div class="hero">
			<div class="wrap">
				<p class="eyebrow">Formación Profesional · Oposiciones · IA</p>
				<h1>Profesor de FP. Experto en oposiciones e IA aplicada al desarrollo.</h1>
				<p class="subhead">
					Soy Ginés López, profesor de Formación Profesional en Informática y
					desarrollador web desde 2016. Llevo el código que aprendí en agencias
					reales a las clases de DAM, DAW y SMR.
				</p>
				<p class="hero-note">Funcionario de Carrera en la Generalitat Valenciana desde 2025.</p>
				<div class="hero-actions">
					<a class="btn primary" href="/contacto/">Escribir un correo</a>
					<a class="btn" href="https://gines-lopez.github.io" target="_blank" rel="noopener">Mis apuntes</a>
					<a class="btn" href="https://docentemente.com" target="_blank" rel="noopener">Docentemente</a>
				</div>
			</div>
		</div>
	</div>

	<hr class="rule" />

	<main>
		<section id="historia" class="reveal">
			<div class="wrap">
				<h2 class="section-title">¿Quién es Ginés López?</h2>
				<p>
					Soy Ginés López García, profesor de Formación Profesional en
					Informática y <strong>formador especializado en inteligencia
					artificial aplicada a la educación</strong>. Llevo la IA
					generativa a las aulas de DAM, DAW y SMR: la uso a diario para
					preparar clases, corregir código y diseñar evaluaciones, y comparto
					con alumnos y docentes lo que de verdad funciona, sin humo.
					Antes de dar clase fui <strong>más de cinco años desarrollador
					web</strong>, especializado en PrestaShop y WordPress, y hoy soy
					<strong>funcionario de carrera</strong> de la Generalitat
					Valenciana tras aprobar la oposición de Informática. Ese oficio y
					esa constancia son los que traslado al aula: que mis alumnos
					salgan sabiendo trabajar con IA, no compitiendo contra ella.
				</p>
			</div>
		</section>

		<section id="ultimo" class="reveal">
			<div class="wrap">
				<h2 class="section-title">Lo último que he hecho</h2>
				<p>
					Un diario de mis proyectos y reflexiones: lo que voy programando,
					probando y aprendiendo sobre IA aplicada a la educación.
				</p>
				<LatestPosts />
				<p class="see-all"><a href="/blog/">Ver todos los artículos →</a></p>
			</div>
		</section>
	</main>
</Layout>

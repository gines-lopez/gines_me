---
import Layout from '../layouts/Layout.astro';

const title = 'Contacto — Ginés López';
const description =
	'Escríbeme para consultas sobre docencia, desarrollo web o IA aplicada a la educación.';

const email = 'docentegineslopez@gmail.com';
const asunto = encodeURIComponent('Contacto desde gines.me');
---

<Layout title={title} description={description}>
	<main class="page-main">
		<section class="reveal">
			<div class="wrap">
				<h1 class="section-title">Hablemos</h1>
				<p>
					¿Tienes una consulta sobre docencia, desarrollo web o IA aplicada a
					la educación? ¿O simplemente quieres contarme algo? Escríbeme y te
					respondo en cuanto pueda.
				</p>

				<div class="contact-actions">
					<a class="btn primary" href={`mailto:${email}?subject=${asunto}`}>
						Escribir a {email}
					</a>
					<a class="btn" href="https://www.linkedin.com/in/gineslopez/" target="_blank" rel="noopener">
						LinkedIn
					</a>
					<a class="btn" href="https://www.instagram.com/docentegineslopez" target="_blank" rel="noopener">
						Instagram
					</a>
				</div>
			</div>
		</section>
	</main>

	<style>
		.contact-actions {
			margin-top: 2rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.9rem;
		}
	</style>
</Layout>

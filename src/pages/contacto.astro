---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../consts';
import { mailto } from '../lib/mailto';

const title = 'Contacto — Ginés López';
const description =
	'Escríbeme para hablar de CódigoFP, docentemente, una colaboración o simplemente para contarme qué te ha parecido El diario.';
---

<Layout title={title} description={description}>
	<main class="page-main">
		<section class="reveal">
			<div class="wrap">
				<h1 class="section-title">Hablemos</h1>
				<p>
					Escríbeme si quieres hablar de <a href="/proyectos/">CódigoFP o docentemente</a>,
					proponerme una colaboración o contarme qué te ha parecido <a href="/blog/">El diario</a>.
					Leo todo lo que llega.
				</p>

				<div class="contact-actions">
					<a class="btn primary" href={mailto('Contacto desde gines.me')}>Escribir a {CONTACT_EMAIL}</a>
				</div>
				<p class="contact-social">
					También estoy en <a href="https://www.linkedin.com/in/gineslopez/" target="_blank" rel="noopener">LinkedIn</a> y <a href="https://www.instagram.com/docentegineslopez" target="_blank" rel="noopener">Instagram</a>.
				</p>
			</div>
		</section>
	</main>

	<style>
		.contact-actions {
			margin-top: 2rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.9rem;
		}
		.contact-actions .btn {
			overflow-wrap: anywhere;
		}
		.contact-social {
			margin-top: 1.6rem;
			font-family: var(--font-heading);
			font-size: 0.9rem;
			color: var(--ink-muted);
		}
	</style>
</Layout>

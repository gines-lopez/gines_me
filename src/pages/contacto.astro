---
import Layout from '../layouts/Layout.astro';

const title = 'Contacto — Ginés López';
const description =
	'Escríbeme para consultas sobre docencia, desarrollo web o IA aplicada a la educación.';

const email = 'docentegineslopez@gmail.com';
const asunto = encodeURIComponent('Contacto desde gines.me');
---

<Layout title={title} description={description}>
	<main class="page-main">
		<section class="reveal">
			<div class="wrap">
				<h1 class="section-title">Hablemos</h1>
				<p>
					¿Tienes una consulta sobre docencia, desarrollo web o IA aplicada a
					la educación? ¿O simplemente quieres contarme algo? Escríbeme y te
					respondo en cuanto pueda.
				</p>

				<p class="contact-email">
					<a class="btn primary" href={`mailto:${email}?subject=${asunto}`}>
						Escribir a {email}
					</a>
				</p>

				<p class="contact-alt">
					También puedes escribirme por
					<a href="https://www.linkedin.com/in/gineslopez/" target="_blank" rel="noopener">LinkedIn</a>
					o por
					<a href="https://www.instagram.com/docentegineslopez" target="_blank" rel="noopener">Instagram</a>.
				</p>
			</div>
		</section>
	</main>

	<style>
		.contact-email {
			margin-top: 2rem;
		}
		.contact-alt {
			margin-top: 1rem;
			color: var(--ink-muted);
		}
	</style>
</Layout>

---
import Layout from '../layouts/Layout.astro';

const title = 'Contacto — Ginés López';
const description =
	'Escríbeme para consultas sobre docencia, desarrollo web o IA aplicada a la educación.';
---

<Layout title={title} description={description}>
	<main class="page-main">
		<section class="reveal">
			<div class="wrap">
				<h1 class="section-title">Hablemos</h1>
				<p>
					¿Tienes una consulta sobre docencia, desarrollo web o IA aplicada a
					la educación? ¿O simplemente quieres contarme algo? Escríbeme y te
					respondo en cuanto pueda.
				</p>

				<form class="contact-form" action="/contacto.php" method="POST">
					<div class="field">
						<label for="nombre">Nombre</label>
						<input type="text" id="nombre" name="nombre" required maxlength="80" autocomplete="name" />
					</div>

					<div class="field">
						<label for="email">Correo de contacto</label>
						<input type="email" id="email" name="email" required maxlength="120" autocomplete="email" />
					</div>

					<div class="field">
						<label for="mensaje">Cuéntame</label>
						<textarea id="mensaje" name="mensaje" required maxlength="4000" rows="7"></textarea>
					</div>

					<div class="field">
						<label for="verificacion">Para comprobar que eres una persona, escribe la palabra <strong>HOLA</strong> en mayúsculas</label>
						<input type="text" id="verificacion" name="verificacion" required maxlength="20" autocomplete="off" />
					</div>

					<div class="hp-field" aria-hidden="true">
						<label for="asunto">Deja este campo vacío</label>
						<input type="text" id="asunto" name="asunto" tabindex="-1" autocomplete="off" />
					</div>

					<button type="submit" class="btn primary">Enviar mensaje</button>
				</form>
			</div>
		</section>
	</main>

	<style>
		.contact-form {
			max-width: 46ch;
			margin-top: 2rem;
			display: flex;
			flex-direction: column;
			gap: 1.3rem;
		}
		.field {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}
		.field label {
			font-family: var(--font-sans);
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--ink);
		}
		input,
		textarea {
			font-family: var(--font-sans);
			font-size: 0.95rem;
			padding: 0.65rem 0.8rem;
			border-radius: 4px;
			border: 1px solid var(--rule);
			background: var(--bg);
			color: var(--ink);
		}
		input:focus,
		textarea:focus {
			outline: 2px solid var(--focus);
			outline-offset: 1px;
		}
		textarea {
			resize: vertical;
		}
		.contact-form button.btn {
			align-self: flex-start;
			cursor: pointer;
		}
		/* Honeypot: oculto visualmente pero accesible a bots que rastrean el HTML. */
		.hp-field {
			position: absolute;
			left: -9999px;
			width: 1px;
			height: 1px;
			overflow: hidden;
		}
	</style>
</Layout>

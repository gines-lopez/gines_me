---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

{
	posts.length > 0 ? (
		<>
			<ul class="latest-posts">
				{posts.map((post) => (
					<li>
						<PostCard post={post} compact />
					</li>
				))}
			</ul>
			<p class="see-all">
				<a href="/blog/">Ver todas las ediciones →</a>
			</p>
		</>
	) : (
		<p class="latest-empty">
			<strong>Primera edición: noviembre de 2026.</strong> Se publicará aquí y en el <a href="/rss.xml">RSS</a>.
		</p>
	)
}

<style>
	.latest-posts {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		list-style: none;
		margin: 1.6rem 0 0;
		padding: 0;
	}
	.latest-empty {
		margin-top: 1.6rem;
		padding: 1.1rem 1.25rem;
		border: 1px dashed var(--rule);
		border-radius: 8px;
		color: var(--ink-muted);
	}
	.latest-empty strong {
		color: var(--ink);
	}
	@media (min-width: 576px) {
		.latest-posts {
			grid-template-columns: repeat(2, 1fr);
			gap: 20px;
		}
	}
</style>

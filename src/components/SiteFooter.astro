---
interface Props {
	variant?: 'full' | 'simple';
}

const { variant = 'simple' } = Astro.props;
---

{
	variant === 'full' ? (
		<footer>
			<div class="wrap">
				<h2>¿Hablamos?</h2>
				<p class="lede">
					Escríbeme si quieres charlar de docencia, desarrollo web o alguna colaboración, echa un
					vistazo a mis apuntes o pásate por mis proyectos en Docentemente.
				</p>
				<div class="hero-actions">
					<a class="btn primary" href="/contacto/">
						Escribir un correo
					</a>
					<a class="btn" href="https://gines-lopez.github.io" target="_blank" rel="noopener">
						Mis apuntes
					</a>
					<a class="btn" href="https://docentemente.com" target="_blank" rel="noopener">
						Docentemente
					</a>
				</div>
				<p class="fineprint">© <span id="year" /> Ginés López · gines.me</p>
			</div>
		</footer>
	) : (
		<footer class="footer-simple">
			<div class="wrap footer-cols">
				<p class="fineprint">© <span id="year" /> gines.me</p>
				<nav class="footer-links">
					<a href="/sobre-mi/">Sobre mí</a>
					<a href="/uso-ia-en-el-proyecto/">Uso de la IA</a>
					<a href="/contacto/">Contacto</a>
				</nav>
				<div class="footer-social">
					<a href="https://www.linkedin.com/in/gineslopez/" target="_blank" rel="noopener">LinkedIn</a>
					<a href="https://www.instagram.com/docentegineslopez" target="_blank" rel="noopener">Instagram</a>
				</div>
			</div>
		</footer>
	)
}

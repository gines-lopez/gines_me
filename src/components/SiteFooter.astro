---
import { PROJECTS, SITE_TAGLINE } from '../consts';

// Se mantiene `variant` por compatibilidad con las páginas que aún lo pasan.
interface Props {
	variant?: 'full' | 'simple';
}
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__intro">
			<p class="site-footer__mark">Ginés López</p>
			<p class="site-footer__tag">{SITE_TAGLINE}</p>
			<p class="fineprint">© <span id="year" /> gines.me</p>
		</div>
		<nav class="site-footer__col" aria-label="El sitio">
			<h2>El sitio</h2>
			<a href="/blog/">El diario</a>
			<a href="/proyectos/">Proyectos</a>
			<a href="/sobre-mi/">Sobre mí</a>
			<a href="/contacto/">Contacto</a>
			<a href="/uso-ia-en-el-proyecto/">Uso de la IA</a>
		</nav>
		<nav class="site-footer__col" aria-label="Fuera de aquí">
			<h2>Fuera de aquí</h2>
			<a href={PROJECTS.codigofp} target="_blank" rel="noopener">CódigoFP</a>
			<a href={PROJECTS.docentemente} target="_blank" rel="noopener">docentemente</a>
			<a href="https://www.linkedin.com/in/gineslopez/" target="_blank" rel="noopener">LinkedIn</a>
			<a href="https://www.instagram.com/docentegineslopez" target="_blank" rel="noopener">Instagram</a>
			<a href="/rss.xml">RSS del diario</a>
		</nav>
	</div>
</footer>

---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	featured?: boolean;
	/** Carga prioritaria de la primera imagen (cuando la lista está sobre el pliegue) */
	eagerFirst?: boolean;
	headingLevel?: 2 | 3;
}

const { posts, featured = false, eagerFirst = false, headingLevel = 3 } = Astro.props;
---

<ul class:list={['post-grid', { 'post-grid--featured': featured }]}>
	{
		posts.map((post, index) => (
			<li>
				<PostCard
					post={post}
					featured={featured}
					eager={eagerFirst && index === 0}
					headingLevel={headingLevel}
				/>
			</li>
		))
	}
</ul>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr));
		gap: 12px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (min-width: 768px) {
		.post-grid {
			gap: 24px;
			grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
		}
		.post-grid--featured {
			grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
		}
	}
</style>

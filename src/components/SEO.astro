---
// Reusable SEO tags: title, description, canonical, Open Graph, Twitter card and JSON-LD.
// Rendered inside <head>, alongside <BaseHead /> which owns the non-SEO boilerplate
// (charset, favicon, sitemap, rss, fonts).
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	article?: boolean;
}

const { title, description, image = FallbackImage, article = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image.src, Astro.url);

const jsonLd = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			image: imageURL.toString(),
			url: canonicalURL.toString(),
			mainEntityOfPage: canonicalURL.toString(),
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: title,
			description,
			url: canonicalURL.toString(),
		};

// Escaping "<" prevents a "</script>" inside title/description from breaking out of the JSON-LD block.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={jsonLdString} />
